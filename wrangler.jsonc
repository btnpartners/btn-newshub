{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "btn-newshub",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "btn-newshub",
      "database_id": "26c2a02c-a074-4fa4-a557-c2224ec540b5"
    }
  ],
  "vars": {
    "CLAUDE_MODEL": "claude-haiku-5-5",
    "REQUIRE_LOGIN": "false",
    "SHARE_EMAIL": "hamilton+newsfintech@btnpartners.com",
    "SHARE_FROM": "btn news <news@notify.btnpartners.com>",
    "SHARE_TO": "hamilton@btnpartners.com",
    "SHARE_LABEL": "Leads/News Fintech",
    "DAILY_EMAIL_LIMIT": "60",
    "DAILY_SUMMARY_LIMIT": "150",
    "ALLOWED_EMAILS": "hamilton@btnpartners.com",
    "GOOGLE_CLIENT_ID": "",
    "FINTECHHUB_URL": "https://btn-fintechhub.pages.dev/"
  },
  "observability": { "enabled": true }
}
